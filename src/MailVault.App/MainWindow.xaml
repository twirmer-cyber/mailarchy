<Window x:Class="MailVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        xmlns:vm="clr-namespace:MailVault.App.ViewModels"
        xmlns:views="clr-namespace:MailVault.App.Views"
        Title="MailArchy" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindow}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StartViewModel}"><views:StartView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchiveViewModel}"><views:ArchiveView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}"><views:ExportView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}"><views:AiView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MessageListViewModel}"><views:MessageListView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Background="{DynamicResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="10,14,10,6">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,14">
                    <Image Source="pack://application:,,,/MailVault.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="MailArchy" />
                    <TextBlock Text="MailArchy" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="{loc:T Nav_Start}" x:Name="NavStart" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE896;" Content="{loc:T Nav_Archive}" x:Name="NavArchive" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE721;" Content="{loc:T Nav_Search}" x:Name="NavSearch" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE99A;" Content="{loc:T Nav_Ai}" x:Name="NavAi" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xEDE1;" Content="{loc:T Nav_Export}" x:Name="NavExport" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{loc:T Nav_Settings}" x:Name="NavSettings" Checked="Nav_Checked" />
                <Separator Margin="4,12" />
                <TextBlock Text="{Binding RootTitle}" FontWeight="SemiBold" Margin="10,0,0,4" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" AutomationProperties.Name="{loc:T Main_FolderTree}"
                      Margin="6,0,6,10" SelectedItemChanged="FolderTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="FolderTree_RightClick"
                      VirtualizingPanel.IsVirtualizing="True">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Display}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T Main_SearchInFolder}" Click="FolderSearch_Click" />
                        <MenuItem Header="{loc:T Main_ExportFolder}" Click="FolderExport_Click" />
                        <Separator />
                        <MenuItem Header="{loc:T Main_RenameFolder}" Click="FolderRename_Click" />
                        <MenuItem Header="{loc:T Common_Delete}" Click="FolderDelete_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="7" Margin="-3,0" Panel.ZIndex="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <ContentControl Grid.Column="2" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
