<Window x:Class="MailVault.App.Dialogs.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        Title="{loc:T Profile_Title}" Width="620" Height="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveRunButton" Content="{loc:T Profile_SaveAndRun}" Style="{StaticResource PrimaryButton}" Click="SaveRun_Click" />
                    <Button Content="{loc:T Common_Save}" IsDefault="True" Click="Save_Click" />
                    <Button Content="{loc:T Common_Cancel}" IsCancel="True" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Grid.IsSharedSizeScope="True">
                <TextBlock x:Name="TypeText" Style="{StaticResource H1}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="Label" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Profile_NameLabel}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" AutomationProperties.Name="{loc:T Profile_Name}" />
                </Grid>

                <!-- Server -->
                <StackPanel x:Name="ServerPanel">
                    <TextBlock Style="{StaticResource H2}" Text="{loc:T Profile_Server}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Profile_EmailLabel}" VerticalAlignment="Top" Margin="0,7,8,0" />
                        <StackPanel Grid.Column="1" Margin="0,3">
                            <DockPanel>
                                <Button x:Name="AutoConfigButton" DockPanel.Dock="Right" Content="{loc:T Profile_AutoConfig}" Margin="8,0,0,0" Click="AutoConfig_Click"
                                        ToolTip="{loc:T Profile_AutoConfigTip}" />
                                <TextBox x:Name="UserBox" LostFocus="UserBox_LostFocus" AutomationProperties.Name="{loc:T Profile_Email}" />
                            </DockPanel>
                            <TextBlock x:Name="AutoConfigText" AutomationProperties.LiveSetting="Polite" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{loc:T Common_PasswordLabel}" />
                        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,3" AutomationProperties.Name="{loc:T Common_Password}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{loc:T Profile_ServerLabel}" />
                        <TextBox x:Name="HostBox" Grid.Row="2" Grid.Column="1" Margin="0,3" AutomationProperties.Name="{loc:T Profile_Server}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="{loc:T Profile_SecurityLabel}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <ComboBox x:Name="SecurityBox" MinWidth="220" SelectedIndex="0" AutomationProperties.Name="{loc:T Profile_Security}">
                                <ComboBoxItem Content="{loc:T Profile_SecurityAuto}" />
                                <ComboBoxItem Content="SSL/TLS" />
                                <ComboBoxItem Content="STARTTLS" />
                                <ComboBoxItem Content="{loc:T Profile_SecurityNone}" />
                            </ComboBox>
                            <TextBlock Text="{loc:T Profile_PortLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox x:Name="PortBox" Width="60" ToolTip="{loc:T Profile_PortTip}" AutomationProperties.Name="{loc:T Profile_Port}" />
                        </StackPanel>
                        <CheckBox x:Name="IgnoreCertBox" Grid.Row="4" Grid.Column="1" Content="{loc:T Profile_IgnoreCert}" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="TestButton" Content="{loc:T Profile_Test}" Click="Test_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"
                               Text="{loc:T Profile_AppPasswordHint}" />
                </StackPanel>

                <!-- Dateien -->
                <StackPanel x:Name="FilePanel">
                    <TextBlock x:Name="FileHeader" Style="{StaticResource H2}" Text="{loc:T Profile_Source}" />
                    <ComboBox x:Name="ThunderbirdProfileBox" AutomationProperties.Name="{loc:T Profile_ThunderbirdProfile}" Margin="0,0,0,6" SelectionChanged="ThunderbirdProfile_Changed" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{loc:T Common_Browse}" Margin="8,0,0,0" Click="Browse_Click" />
                        <TextBox x:Name="PathBox" AutomationProperties.LabeledBy="{Binding ElementName=FileHeader}" />
                    </DockPanel>
                    <CheckBox x:Name="RecursiveBox" Content="{loc:T Profile_Recursive}" Margin="0,6,0,0" />
                    <TextBlock x:Name="OutlookHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{loc:T Profile_OutlookHint}" />
                    <Button x:Name="LoadFoldersButton" Content="{loc:T Profile_LoadFolders}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Test_Click" />
                </StackPanel>

                <!-- Ordner -->
                <TextBlock Style="{StaticResource H2}" Text="{loc:T Common_Folders}" />
                <CheckBox x:Name="SpecialFoldersBox" Content="{loc:T Profile_SkipSpecial}" />
                <TextBlock x:Name="FolderHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,4"
                           Text="{loc:T Profile_FolderHint}" />
                <ListBox x:Name="FolderList" AutomationProperties.Name="{loc:T Common_Folders}" MaxHeight="180" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="ExcludedPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,2" Text="{loc:T Profile_ExcludedLabel}" />
                    <TextBox x:Name="ExcludedBox" AutomationProperties.Name="{loc:T Profile_Excluded}" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <!-- Filter -->
                <TextBlock Style="{StaticResource H2}" Text="{loc:T Profile_Filter}" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="NewerThanBox" Content="{loc:T Profile_NewerThan}" VerticalAlignment="Center" />
                    <TextBox x:Name="NewerThanDays" AutomationProperties.Name="{loc:T Profile_NewerThanDays}" Width="50" Margin="6,0" Text="30" />
                    <TextBlock Text="{loc:T Profile_Days}" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="160" SharedSizeGroup="Label" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Profile_TargetLabel}" />
                    <TextBox x:Name="TargetBox" AutomationProperties.Name="{loc:T Profile_Target}" Grid.Column="1" ToolTip="{loc:T Profile_TargetTip}" />
                </Grid>

                <!-- Zeitplan -->
                <TextBlock Style="{StaticResource H2}" Text="{loc:T Profile_Schedule}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ScheduleBox" AutomationProperties.Name="{loc:T Profile_Schedule}" MinWidth="200" SelectionChanged="Schedule_Changed">
                        <ComboBoxItem Content="{loc:T Profile_ScheduleManual}" />
                        <ComboBoxItem Content="{loc:T Profile_ScheduleInterval}" />
                        <ComboBoxItem Content="{loc:T Profile_ScheduleDaily}" />
                    </ComboBox>
                    <ComboBox x:Name="IntervalBox" AutomationProperties.Name="{loc:T Profile_Interval}" MinWidth="160" Margin="8,0,0,0" DisplayMemberPath="Value" SelectedValuePath="Key" />
                    <StackPanel x:Name="DailyPanel" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="{loc:T Profile_At}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="DailyTimeBox" AutomationProperties.Name="{loc:T Profile_Time}" Width="60" ToolTip="{loc:T Profile_TimeTip}" />
                        <TextBlock Text="{loc:T Profile_OClock}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ScheduleHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{loc:T Profile_ScheduleHint}" />

                <!-- Nur lesen -->
                <Border x:Name="ReadOnlyNote" Background="{DynamicResource NoteBackBrush}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="{loc:T Profile_ReadOnlyNote}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
