<Window x:Class="MailVault.App.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        Title="{loc:T Login_Title}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Style="{StaticResource H1}" Text="{loc:T Login_Header}" />

        <StackPanel x:Name="PasswordPanel">
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" Text="{loc:T Login_EnterPassword}" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{loc:T Password_Title}" />
            <TextBlock Margin="0,8,0,0">
                <Hyperlink Click="Forgot_Click"><Run Text="{loc:T Login_Forgot}" /></Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
            <TextBlock x:Name="RecoveryIntro" Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="{loc:T Login_RecoveryIntro}" />
            <StackPanel x:Name="SheetPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Button Content="{loc:T Login_PickSheet}" HorizontalAlignment="Left" Click="PickSheet_Click" />
                <TextBlock x:Name="SheetStatus" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{loc:T Common_RecoveryKeyLabel}" />
            <TextBox x:Name="RecoveryBox" AutomationProperties.Name="{loc:T Common_RecoveryKey}" FontFamily="Consolas" Margin="0,2,0,8" />
            <TextBlock Text="{loc:T Common_NewPasswordLabel}" />
            <PasswordBox x:Name="NewPassword1" AutomationProperties.Name="{loc:T Common_NewPassword}" Margin="0,2,0,8" />
            <TextBlock Text="{loc:T Common_ConfirmPasswordLabel}" />
            <PasswordBox x:Name="NewPassword2" AutomationProperties.Name="{loc:T Common_ConfirmPassword}" Margin="0,2,0,0" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="{loc:T Login_SignIn}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            <Button Content="{loc:T Common_Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
