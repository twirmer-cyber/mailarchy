<Window x:Class="MailVault.App.Dialogs.RecoveryKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        Title="{loc:T Common_RecoveryKey}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Style="{StaticResource H2}" Margin="0,0,0,8" TextWrapping="Wrap" Text="{loc:T Recovery_Success}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{loc:T Recovery_Intro}" />
        <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="4" Padding="12">
            <TextBox x:Name="KeyBox" AutomationProperties.Name="{loc:T Common_RecoveryKey}" IsReadOnly="True" FontFamily="Consolas" FontSize="20" BorderThickness="0"
                     Background="Transparent" HorizontalContentAlignment="Center" />
        </Border>
        <WrapPanel Margin="0,16,0,0">
            <Button Content="{loc:T Recovery_Print}" Style="{StaticResource PrimaryButton}" Click="Print_Click" />
            <Button Content="{loc:T Recovery_SaveFile}" Click="Save_Click" />
            <Button Content="{loc:T Common_Copy}" Click="Copy_Click" />
        </WrapPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />

        <TextBlock FontWeight="SemiBold" Margin="0,16,0,4" Text="{loc:T Recovery_AdviceTitle}" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{loc:T Recovery_Advice}" />

        <CheckBox x:Name="ConfirmBox" Margin="0,16,0,0" Content="{loc:T Recovery_ConfirmBox}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T Common_Close}" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"
                    IsEnabled="{Binding IsChecked, ElementName=ConfirmBox}" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
