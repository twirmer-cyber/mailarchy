<Window x:Class="MailVault.App.Dialogs.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        Title="{loc:T FirstRun_Title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Style="{StaticResource BaseWindow}">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource H1}" Text="{loc:T FirstRun_Welcome}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                   Text="{loc:T FirstRun_Intro}" />
        <TextBlock x:Name="PathLabel" Text="{loc:T FirstRun_PathLabel}" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:T Common_Browse}" Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="PathBox" AutomationProperties.Name="{loc:T FirstRun_PathName}" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{loc:T FirstRun_Create}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            <Button Content="{loc:T Common_Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
