<Window x:Class="MailVault.App.Dialogs.WebUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        Title="{loc:T WebUser_Title}" Width="520" Height="600" WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindow}" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="{loc:T WebUser_New}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Common_UserNameLabel}" />
                <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,3" AutomationProperties.Name="{loc:T Common_UserName}" />
                <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{loc:T Common_PasswordLabel}" />
                <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{loc:T Common_Password}" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{loc:T WebUser_RepeatLabel}" />
                <PasswordBox x:Name="Password2Box" AutomationProperties.Name="{loc:T WebUser_Repeat}" Grid.Row="2" Grid.Column="1" Margin="0,3" />
            </Grid>
            <TextBlock x:Name="PasswordHint" Style="{StaticResource Muted}" FontSize="12" Margin="140,0,0,6"
                       Text="{loc:T WebUser_MinLength}" />
            <CheckBox x:Name="EnabledBox" Content="{loc:T WebUser_Enabled}" IsChecked="True" Margin="0,4" />
            <CheckBox x:Name="AdminBox" Content="{loc:T WebUser_Admin}" Margin="0,4" Checked="Admin_Changed" Unchecked="Admin_Changed" />
            <TextBlock Style="{StaticResource H2}" Text="{loc:T WebUser_SharedMailboxes}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="{loc:T WebUser_SharedHint}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{loc:T Common_Save}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                <Button Content="{loc:T Common_Cancel}" IsCancel="True" Margin="0" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="FolderList" AutomationProperties.Name="{loc:T WebUser_SharedMailboxes}" BorderBrush="{DynamicResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Display}" Margin="{Binding Indent}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
