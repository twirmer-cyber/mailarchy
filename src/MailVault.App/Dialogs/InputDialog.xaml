<Window x:Class="MailVault.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
        Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" AutomationProperties.LabeledBy="{Binding ElementName=PromptText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="{loc:T Common_Apply}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            <Button Content="{loc:T Common_Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
