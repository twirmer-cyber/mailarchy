<UserControl x:Class="MailVault.App.Views.MessageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
             xmlns:views="clr-namespace:MailVault.App.Views">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:T Common_Open}" Command="{Binding OpenCommand}" ToolTip="{loc:T List_OpenTip}" />
                    <Button Content="{loc:T Common_SaveAs}" Command="{Binding SaveAsCommand}" />
                    <Button Content="{loc:T List_SavePdf}" Command="{Binding SavePdfCommand}" ToolTip="{loc:T List_SavePdfTip}" AutomationProperties.AutomationId="SavePdf" />
                    <Button Content="{loc:T Common_Delete}" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" ToolTip="{loc:T List_DeleteTip}" />
                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="{loc:T Common_Refresh}" AutomationProperties.Name="{loc:T Common_Refresh}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="MessagesGrid" Grid.Row="1" AutomationProperties.Name="{loc:T Common_Emails}" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                  BorderThickness="0" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick"
                  PreviewKeyDown="Grid_KeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:T Common_Open}" Command="{Binding OpenCommand}" />
                    <MenuItem Header="{loc:T Common_SaveAs}" Command="{Binding SaveAsCommand}" />
                    <MenuItem Header="{loc:T List_SavePdf}" Command="{Binding SavePdfCommand}" />
                    <MenuItem Header="{loc:T List_CopyList}" Command="{Binding CopyToClipboardCommand}" />
                    <MenuItem Header="{loc:T List_AskAi}" Command="{Binding AskAiCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T Common_Delete}" Command="{Binding DeleteCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="28" SortMemberPath="HasAttachments">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{loc:T Common_Attachment}" ToolTip="{loc:T List_SortByAttachment}" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{loc:T Common_Attachment}" ToolTip="{loc:T Search_WithAttachment}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:T Common_From}" Width="2*" SortMemberPath="FromName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FromName}" ToolTip="{Binding From}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:T Common_Subject}" Binding="{Binding Subject}" Width="4*" />
                <DataGridTextColumn Header="{loc:T Common_Date}" Binding="{Binding DateUtc, Converter={x:Static views:UtcToLocalConverter.Instance}, StringFormat=g}"
                                    SortMemberPath="DateUtc" Width="125" />
                <DataGridTextColumn Header="{loc:T Common_Size}" Binding="{Binding Size, Converter={x:Static views:SizeConverter.Instance}}" SortMemberPath="Size" Width="75" />
                <DataGridTextColumn Header="{loc:T Common_Folder}" Binding="{Binding FolderPath}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="7" Margin="0,-3" Panel.ZIndex="1" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

        <views:MessagePreview Grid.Row="3" MessageId="{Binding SelectedMessageId}" />

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
