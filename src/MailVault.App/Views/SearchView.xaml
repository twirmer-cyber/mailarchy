<UserControl x:Class="MailVault.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization"
             xmlns:views="clr-namespace:MailVault.App.Views">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16,20,12" Background="{DynamicResource SidebarBrush}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="{loc:T Common_Search}" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" />
                        <Button Content="{loc:T Search_Reset}" Margin="0" Command="{Binding ResetCommand}" />
                    </StackPanel>
                    <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"
                             AutomationProperties.Name="{loc:T Search_QueryName}"
                             views:Field.Placeholder="{loc:T Search_Placeholder}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="2,6,0,0"
                           Visibility="{Binding ErrorText, Converter={x:Static views:NullToCollapsedConverter.Instance}}" />

                <!-- Filter-Chips -->
                <WrapPanel Margin="0,10,0,0">
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="range" Content="{loc:T Search_AllPeriods}" IsChecked="{Binding QuickRange, Converter={x:Static views:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="range" Content="{loc:T Search_Last30}" IsChecked="{Binding QuickRange, Converter={x:Static views:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="range" Content="{loc:T Search_ThisYear}" IsChecked="{Binding QuickRange, Converter={x:Static views:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="range" Content="{loc:T Search_LastYear}" IsChecked="{Binding QuickRange, Converter={x:Static views:IntEqualsConverter.Instance}, ConverterParameter=3}" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource BorderBrush}" Margin="6,0,12,0" />
                    <ToggleButton Style="{StaticResource Chip}" Content="{loc:T Search_WithAttachment}" IsChecked="{Binding WithAttachment}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="{loc:T Search_BestFirst}" IsChecked="{Binding SortByRelevance}"
                                  ToolTip="{loc:T Search_BestFirstTip}" />
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource BorderBrush}" Margin="6,0,12,0" />
                    <ToggleButton Style="{StaticResource Chip}" Content="{loc:T Search_MoreFilters}" IsChecked="{Binding ShowAdvanced}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="{loc:T Search_Help}" IsChecked="{Binding ShowHelp}" />
                </WrapPanel>

                <!-- Hilfe: Beispiele zum Einfügen -->
                <Border Visibility="{Binding ShowHelp, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Search_HelpIntro}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding SyntaxExamples}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,16,2">
                                        <Button DockPanel.Dock="Left" Content="{Binding Example}" FontFamily="Consolas" MinWidth="0" Padding="6,1" Margin="0,0,8,0"
                                                Command="{Binding DataContext.InsertExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Meaning}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Weitere Filter -->
                <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <WrapPanel>
                        <TextBlock Text="{loc:T Search_SearchIn}" Style="{StaticResource Muted}" Margin="0,3,10,0" />
                        <CheckBox Content="{loc:T Common_Subject}" IsChecked="{Binding InSubject}" Margin="0,3,14,3" />
                        <CheckBox Content="{loc:T Search_FromTo}" IsChecked="{Binding InFromTo}" Margin="0,3,14,3" />
                        <CheckBox Content="{loc:T Search_Body}" IsChecked="{Binding InBody}" Margin="0,3,14,3" />
                        <CheckBox Content="{loc:T Search_AttachmentNames}" IsChecked="{Binding InAttachmentNames}" Margin="0,3,14,3" />
                        <CheckBox Content="{loc:T Search_AttachmentContents}" IsChecked="{Binding InAttachmentContents}" Margin="0,3,14,3" />
                    </WrapPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Search_FromLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding From}" Margin="0,3" AutomationProperties.Name="{loc:T Common_From}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="{loc:T Search_ToLabel}" />
                        <TextBox Grid.Column="4" Text="{Binding To}" Margin="0,3" AutomationProperties.Name="{loc:T Search_To}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{loc:T Search_DateLabel}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3">
                            <ComboBox AutomationProperties.Name="{loc:T Common_Date}" ItemsSource="{Binding DateRanges}" SelectedItem="{Binding DateRange}" DisplayMemberPath="Display" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}">
                                <DatePicker SelectedDate="{Binding DateFrom}" Width="120" AutomationProperties.Name="{loc:T Search_DateFrom}" />
                                <TextBlock Text="{loc:T Common_To}" VerticalAlignment="Center" Margin="6,0" />
                                <DatePicker SelectedDate="{Binding DateTo}" Width="120" AutomationProperties.Name="{loc:T Search_DateTo}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsDaysRange, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding Days}" Width="60" AutomationProperties.Name="{loc:T Search_DayCount}" />
                                <TextBlock Text="{loc:T Profile_Days}" VerticalAlignment="Center" Margin="6,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource FormLabel}" Text="{loc:T Search_FolderLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,3" VerticalAlignment="Top" AutomationProperties.Name="{loc:T Common_Folder}" ItemsSource="{Binding Folders}"
                                  SelectedItem="{Binding Folder}" DisplayMemberPath="Display" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{loc:T Search_AttachmentsLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" AutomationProperties.Name="{loc:T Search_Attachments}" ItemsSource="{Binding AttachmentOptions}"
                                  SelectedItem="{Binding Attachments}" DisplayMemberPath="Display" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource FormLabel}" Text="{loc:T Search_PriorityLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="4" Margin="0,3" AutomationProperties.Name="{loc:T Search_Priority}" ItemsSource="{Binding PriorityOptions}"
                                  SelectedItem="{Binding Priority}" DisplayMemberPath="Display" />

                        <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="{loc:T Search_SizeLabel}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <TextBox Text="{Binding SizeMinKb}" Width="70" ToolTip="{loc:T Search_AtLeast}" AutomationProperties.Name="{loc:T Search_SizeMin}" />
                            <TextBlock Text="{loc:T Common_To}" VerticalAlignment="Center" Margin="6,0" />
                            <TextBox Text="{Binding SizeMaxKb}" Width="70" ToolTip="{loc:T Search_AtMost}" AutomationProperties.Name="{loc:T Search_SizeMax}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="{loc:T Search_EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center"
                           Text="{loc:T Search_EmptyHint}" />
            </StackPanel>
            <ContentControl Content="{Binding Results}" Visibility="{Binding Results, Converter={x:Static views:NullToCollapsedConverter.Instance}}"
                            Background="{DynamicResource SurfaceBrush}" Focusable="False" />
        </Grid>
    </DockPanel>
</UserControl>
