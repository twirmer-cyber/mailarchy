<UserControl x:Class="MailVault.App.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="{loc:T Nav_Export}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="{loc:T Export_Intro}" />

            <TextBlock Style="{StaticResource H2}" Text="{loc:T Export_Scope}" />
            <ComboBox AutomationProperties.Name="{loc:T Export_Scope}" ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Display" />

            <TextBlock Style="{StaticResource H2}" Text="{loc:T Export_Format}" />
            <RadioButton Content="{loc:T Export_Eml}" IsChecked="{Binding FormatEml}" GroupName="fmt" Margin="0,2" />
            <RadioButton Content="{loc:T Export_Mbox}" IsChecked="{Binding FormatMbox}" GroupName="fmt" Margin="0,2" />
            <CheckBox Content="{loc:T Export_KeepStructure}" IsChecked="{Binding KeepStructure}" Margin="0,8,0,0" />

            <TextBlock Style="{StaticResource H2}" Text="{loc:T Export_Target}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T Common_Browse}" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Export_Target}" />
            </DockPanel>

            <Button Content="{loc:T Common_Export}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,24,0,0"
                    Command="{Binding ExportCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
