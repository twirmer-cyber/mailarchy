<UserControl x:Class="MailVault.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailVault.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,4,16,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="32,26,32,0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="{loc:T Nav_Settings}" />
        <TabControl SelectedIndex="{Binding SelectedTab}" BorderThickness="0,1,0,0" Padding="0,16,0,0">

            <!-- ============================================================ Archiv -->
            <TabItem Header="{loc:T Start_Archive}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Location}" />
                                <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{loc:T Settings_Location}" />
                                <TextBlock Text="{Binding StatsText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <TextBlock Text="{loc:T Settings_Portable}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Visibility="{Binding IsPortable, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{loc:T Settings_OpenFolder}" Command="{Binding OpenDataDirectoryCommand}" />
                                    <Button Content="{loc:T Settings_ChangeLocation}" Command="{Binding ChangeDataDirectoryCommand}" />
                                    <Button Content="{loc:T Settings_ImportArchive}" Command="{Binding ImportArchiveCommand}"
                                            ToolTip="{loc:T Settings_ImportArchiveTip}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Protection}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="{loc:T Settings_ProtectionIntro}" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="{loc:T Settings_Protect}" Style="{StaticResource PrimaryButton}" Command="{Binding EnableProtectionCommand}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource OkBrush}" />
                                        <TextBlock Text="{loc:T Login_Header}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Visibility="{Binding RecoveryKeyMissing, Converter={StaticResource BoolToVis}}"
                                               Text="{loc:T Settings_RecoveryKeyMissingHint}" />
                                    <WrapPanel>
                                        <Button Content="{loc:T Settings_ChangePassword}" Command="{Binding ChangePasswordCommand}" />
                                        <Button Content="{loc:T Settings_NewRecoveryKey}" Command="{Binding NewRecoveryKeyCommand}" />
                                        <Button Content="{loc:T Settings_CheckRecoveryKey}" Command="{Binding CheckRecoveryKeyCommand}" />
                                        <Button Content="{loc:T Settings_BackupKeyFile}" Command="{Binding BackupKeyFileCommand}" />
                                        <Button Content="{loc:T Settings_RemoveProtection}" Command="{Binding DisableProtectionCommand}" />
                                    </WrapPanel>
                                </StackPanel>

                                <Expander Header="{loc:T Settings_SecurityHelpTitle}" Margin="0,14,0,0">
                                    <StackPanel Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left">
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Help_WhatTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="{loc:T Help_What}" />
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Help_KeysTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="{loc:T Help_Keys}" />
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Help_StoreTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="{loc:T Help_Store}" />
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Help_PasswordTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="{loc:T Help_Password}" />
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Help_LimitsTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10" Text="{loc:T Help_Limits}" />
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Help_BackupTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T Help_Backup}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Privacy}" />
                                <CheckBox Content="{loc:T Settings_BlockExternal}" IsChecked="{Binding BlockExternalContent}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="22,0,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Settings_BlockExternalHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Maintenance}" />
                                <WrapPanel>
                                    <Button Content="{loc:T Settings_RebuildIndex}" Command="{Binding RebuildIndexCommand}" Margin="0,0,8,6" />
                                    <Button Content="{loc:T Settings_Compact}" Command="{Binding CompactCommand}" Margin="0,0,8,6" />
                                    <Button Content="{loc:T Settings_Verify}" Command="{Binding VerifyCommand}" Margin="0,0,8,6" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Settings_BackupHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Appearance}" />
                                <ComboBox SelectedIndex="{Binding ThemeIndex}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="{loc:T Settings_Appearance}">
                                    <ComboBoxItem Content="{loc:T Settings_LikeWindows}" />
                                    <ComboBoxItem Content="{loc:T Settings_Light}" />
                                    <ComboBoxItem Content="{loc:T Settings_Dark}" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Settings_AppearanceHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Language}" />
                                <ComboBox SelectedIndex="{Binding LanguageIndex}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="{loc:T Settings_Language}">
                                    <ComboBoxItem Content="{loc:T Settings_LikeWindows}" />
                                    <ComboBoxItem Content="Deutsch" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Français" />
                                    <ComboBoxItem Content="Español" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Settings_LanguageHint}" />
                                <Button Content="{loc:T Settings_RestartNow}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding RestartAppCommand}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Text="{loc:T Settings_About}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Automatik -->
            <TabItem Header="{loc:T Settings_TabAutomation}" DataContext="{Binding Automation}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Background}" />
                                <CheckBox Content="{loc:T Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                                <CheckBox Content="{loc:T Settings_CloseToTray}"
                                          IsChecked="{Binding CloseToTray}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding AutostartHint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,4,0,0" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{loc:T Settings_ScheduleHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Schedules}" />
                                <DataGrid AutomationProperties.Name="{loc:T Settings_Schedules}" ItemsSource="{Binding Schedules}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          MaxHeight="260"
                                          CanUserAddRows="False" RowHeaderWidth="0">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:T Settings_ColProfile}" Binding="{Binding Name}" Width="170" />
                                        <DataGridTextColumn Header="{loc:T Settings_ColSchedule}" Binding="{Binding Schedule}" Width="Auto" MinWidth="130" />
                                        <DataGridTextColumn Header="{loc:T Settings_ColNext}" Binding="{Binding Next}" Width="Auto" MinWidth="120" />
                                        <DataGridTextColumn Header="{loc:T Settings_ColLastRun}" Binding="{Binding Status}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Notify}" />
                                <CheckBox Content="{loc:T Settings_NotifyEnabled}" IsChecked="{Binding NotifyEnabled}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="170" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Settings_RecipientLabel}" />
                                    <TextBox Grid.Column="1" Margin="0,3" Text="{Binding NotifyTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Settings_Recipient}" ToolTip="{loc:T Settings_RecipientTip}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{loc:T Settings_SenderLabel}" />
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="{loc:T Profile_AutoConfig}" Margin="8,0,0,0" Command="{Binding AutoConfigCommand}" />
                                        <TextBox Text="{Binding SmtpFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Settings_Sender}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{loc:T Settings_SmtpServerLabel}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                        <TextBox Width="260" Text="{Binding SmtpHost}" AutomationProperties.Name="{loc:T Settings_SmtpServer}" />
                                        <TextBlock Text="{loc:T Profile_PortLabel}" VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <TextBox Width="55" Text="{Binding SmtpPort}" AutomationProperties.Name="{loc:T Settings_SmtpPort}" />
                                        <ComboBox MinWidth="150" Margin="10,0,0,0" SelectedIndex="{Binding SmtpSecurity}" AutomationProperties.Name="{loc:T Settings_Encryption}">
                                            <ComboBoxItem Content="{loc:T Profile_SecurityAuto}" />
                                            <ComboBoxItem Content="SSL/TLS" />
                                            <ComboBoxItem Content="STARTTLS" />
                                            <ComboBoxItem Content="{loc:T Settings_Unencrypted}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="{loc:T Common_UserNameLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding SmtpUser}" AutomationProperties.Name="{loc:T Settings_SmtpUser}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="{loc:T Common_PasswordLabel}" />
                                    <PasswordBox x:Name="SmtpPasswordBox" AutomationProperties.Name="{loc:T Settings_SmtpPassword}" Grid.Row="4" Grid.Column="1" Margin="0,3" PasswordChanged="SmtpPassword_Changed" />
                                    <CheckBox Grid.Row="5" Grid.Column="1" Content="{loc:T Profile_IgnoreCert}" IsChecked="{Binding SmtpIgnoreCert}" Margin="0,3" />
                                    <TextBlock Grid.Row="6" Style="{StaticResource FormLabel}" Text="{loc:T Settings_NotifyAfterLabel}" />
                                    <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,3">
                                        <TextBox Width="40" Text="{Binding FailureThreshold}" AutomationProperties.Name="{loc:T Settings_NotifyAfter}" />
                                        <TextBlock Text="{loc:T Settings_FailuresRepeat}" VerticalAlignment="Center" Margin="6,0" />
                                        <TextBox Width="40" Text="{Binding RepeatHours}" AutomationProperties.Name="{loc:T Settings_RepeatHours}" />
                                        <TextBlock Text="{loc:T Settings_Hours}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </WrapPanel>
                                    <CheckBox Grid.Row="7" Grid.Column="1" Content="{loc:T Settings_NotifyRecovery}" IsChecked="{Binding NotifyOnRecovery}" Margin="0,3" />
                                </Grid>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Text="{loc:T Settings_NotifySignInHint}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{loc:T Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNotificationCommand}" Margin="0,0,8,0" />
                                    <Button Content="{loc:T Settings_SendTest}" Command="{Binding SendTestCommand}" Margin="0,0,8,0" />
                                    <Button Content="{loc:T Settings_FromProfile}" Command="{Binding FromProfileCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding NotifyStatus}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotifyStatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:T Settings_NotifyTip}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Webzugriff -->
            <TabItem Header="{loc:T Settings_TabWeb}" DataContext="{Binding Web}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_WebTitle}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="{loc:T Settings_WebIntro}" />
                                <CheckBox Content="{loc:T Settings_WebEnable}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="{loc:T Profile_PortLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="70" Text="{Binding Port}" AutomationProperties.Name="{loc:T Settings_WebPort}" />
                                    <Button Content="{loc:T Common_Apply}" Margin="8,0,0,0" Command="{Binding ApplyPortCommand}" />
                                    <CheckBox Content="{loc:T Settings_LanAccess}" IsChecked="{Binding LanAccess}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Urls}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="{loc:T Settings_BrowserAddress}" Foreground="{DynamicResource AccentBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{loc:T Settings_OpenInBrowser}" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding OpenInBrowserCommand}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="{loc:T Settings_FirewallHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Users}" />
                                <DataGrid AutomationProperties.Name="{loc:T Settings_Users}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                          MinHeight="80" MaxHeight="280" RowHeaderWidth="0" MouseDoubleClick="Users_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:T Settings_ColUser}" Binding="{Binding UserName}" Width="140" />
                                        <DataGridTextColumn Header="{loc:T Settings_ColRole}" Binding="{Binding Role}" Width="180" />
                                        <DataGridTextColumn Header="{loc:T Settings_ColShared}" Binding="{Binding Access}" Width="*" />
                                        <DataGridTextColumn Header="{loc:T Settings_ColStatus}" Binding="{Binding State}" Width="170" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{loc:T Settings_AddUser}" Style="{StaticResource PrimaryButton}" Command="{Binding AddUserCommand}" />
                                    <Button Content="{loc:T Common_Edit}" Command="{Binding EditUserCommand}" />
                                    <Button Content="{loc:T Common_Delete}" Style="{StaticResource DangerButton}" Command="{Binding DeleteUserCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ KI -->
            <TabItem Header="{loc:T Nav_Ai}" DataContext="{Binding Ai}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Settings_Claude}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="{loc:T Settings_AiIntro}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="170" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Settings_ApiKeyLabel}" />
                                    <DockPanel Grid.Column="1" Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="{loc:T Settings_CreateKey}" Margin="8,0,0,0" Command="{Binding OpenConsoleCommand}" />
                                        <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="{loc:T Settings_ApiKey}" PasswordChanged="ApiKey_Changed" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{loc:T Settings_ModelLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Models}" AutomationProperties.Name="{loc:T Settings_Model}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding Model}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="{loc:T Settings_MaxReadLabel}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                        <TextBox Width="50" Text="{Binding MaxEmailsRead}" AutomationProperties.Name="{loc:T Settings_MaxRead}" />
                                        <TextBlock Text="{loc:T Settings_MaxReadHint}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource WarnBackBrush}" CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{loc:T Settings_PrivacyRead}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Text="{loc:T Settings_AiPrivacy}" />
                                        <CheckBox Content="{loc:T Settings_AiConsent}" IsChecked="{Binding Consent}" Margin="0,8,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{loc:T Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                                    <Button Content="{loc:T Settings_TestConnection}" Command="{Binding TestCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ============================================================ Updates -->
            <TabItem Header="{loc:T Settings_TabUpdates}" DataContext="{Binding Updates}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Upd_ProgramVersion}" />
                                <TextBlock>
                                    <Run Text="{loc:T Upd_InstalledLabel}" /><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <StackPanel Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}">
                                        <Run Text="{loc:T Upd_NotInstalledHint}" /><Run Text="{Binding InstallTarget, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="{loc:T Upd_InstallButton}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding InstallAppCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsInstalled}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{loc:T Upd_Title}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="{loc:T Upd_ServerLabel}" />
                                    <TextBlock Grid.Column="1" Margin="0,7" Text="{Binding ServerDisplay}" ToolTip="{loc:T Upd_ServerTip}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="{loc:T Upd_ChannelLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" Width="300" HorizontalAlignment="Left" SelectedIndex="{Binding ChannelIndex}" AutomationProperties.Name="{loc:T Upd_ChannelName}">
                                        <ComboBoxItem Content="{loc:T Upd_ChannelStable}" />
                                        <ComboBoxItem Content="{loc:T Upd_ChannelBeta}" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="{loc:T Upd_AutoCheck}" IsChecked="{Binding AutoCheck}" Margin="0,10,0,0" />
                                <CheckBox Content="{loc:T Upd_AutoInstall}" IsChecked="{Binding AutoInstall}" IsEnabled="{Binding AutoCheck}" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{loc:T Upd_CheckButton}" Command="{Binding CheckCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Status}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding UpdateTitle}" />
                                <TextBlock Text="{loc:T Upd_ChangesLabel}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Changes}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <BulletDecorator Margin="0,1">
                                                <BulletDecorator.Bullet>
                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                                                </BulletDecorator.Bullet>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </BulletDecorator>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{loc:T Upd_InstallNow}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding InstallCommand}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{loc:T Upd_InstallHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
