<!-- Helle Palette nach DESIGN.md. Dieselben Schlüssel stehen in Dark.xaml; ThemeManager tauscht das Wörterbuch aus.
     Oberflächen verwenden die Pinsel immer als DynamicResource, damit das Umschalten ohne Neustart wirkt. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#2C5B8E</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="PageBrush" Color="#FAF9F7" />          <!-- paper -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#F1F0EC" />       <!-- shelf -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E0DA" />        <!-- line -->
    <SolidColorBrush x:Key="LineStrongBrush" Color="#CFCCC4" />
    <SolidColorBrush x:Key="InputEdgeBrush" Color="#8C9097" />     <!-- Unterkante von Eingabefeldern, ≥ 3:1 -->
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />          <!-- ink -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5C626C" />     <!-- ink-2 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2C5B8E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#234B76" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1C3D61" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E7EDF4" />   <!-- accent-soft: Auswahl -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F4F3EF" />         <!-- Überfahren auf surface/paper -->
    <SolidColorBrush x:Key="PressedBrush" Color="#EAE8E3" />
    <SolidColorBrush x:Key="ShelfHoverBrush" Color="#E7E5DF" />    <!-- Überfahren auf shelf -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C1B9" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8C9097" />
    <SolidColorBrush x:Key="OkBrush" Color="#2F6B3A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarnBackBrush" Color="#FBF4E4" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#4A3300" />      <!-- Text auf warn-Fläche, aus deren Ton abgeleitet -->
    <SolidColorBrush x:Key="DangerBrush" Color="#A8322D" />
    <SolidColorBrush x:Key="DangerBackBrush" Color="#FBEDEC" />
    <SolidColorBrush x:Key="NoteBackBrush" Color="#F1F0EC" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#2C5B8E" />
    <SolidColorBrush x:Key="SelectedGlyphBrush" Color="#2C5B8E" />
    <SolidColorBrush x:Key="FocusBrush" Color="#2C5B8E" />
    <Color x:Key="WebBackgroundColor">#FAF9F7</Color>
</ResourceDictionary>
