<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MailVault.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.7.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="XstReader.Api" Version="1.0.6" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>
  <!-- Client-IDs der OAuth-App-Registrierungen: nur lokal (von Git ignoriert), siehe docs/OAUTH.md -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\build\oauth-clients.local.json')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\build\oauth-clients.local.json" LogicalName="MailVault.Core.oauth-clients.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MailVault.Tests" />
  </ItemGroup>
</Project>
